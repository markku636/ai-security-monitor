{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Security Monitor",
  "version": "0.8.0",
  "identifier": "dev.ai-security-monitor.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Security Monitor",
        "width": 1200,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "visible": false,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBOTA5RTNBQ0M1MTUyREIKUldUYlVsSE1PcDZRR2h4ZlhweUdPQ1d3R1Y5ZmFORXlaenl0SHhEaml0Y0s4RTFVZTg3elVXaTcK",
      "endpoints": ["https://github.com/markku636/ai-security-monitor/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
