# Security Hub（docker/compose.yml、docker/compose.standalone.yml）的設定。
# 複製成 .env 後填值：cp .env.example .env
# 產生隨機值：openssl rand -hex 32（Windows PowerShell：-join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })）
# 變數名改用 AI_SECURITY_MONITOR_HUB_*；舊的 ASA_HUB_*（0.1.x 的 .env）照樣有效，兩個都設時新名優先。

# 必填：管理員金鑰（登入網頁、管理 API）。
AI_SECURITY_MONITOR_HUB_ADMIN_SECRET=
# 必填：PostgreSQL 密碼（只在 docker network 內使用）。
AI_SECURITY_MONITOR_HUB_DB_PASSWORD=

# 選填：agent 上傳用的固定金鑰（逗號分隔）。也可以在網頁「設定與金鑰 → 註冊金鑰」建立，建議用後者。
AI_SECURITY_MONITOR_HUB_CLIENT_SECRETS=
# 對外網址（安裝指令、/install.sh 會用）。例：https://hub.example.com
AI_SECURITY_MONITOR_HUB_PUBLIC_URL=
# 主機上的 port（預設 8088）與綁定位址（伺服器版預設 0.0.0.0；單機版固定 127.0.0.1）。
AI_SECURITY_MONITOR_HUB_HOST_PORT=8088
AI_SECURITY_MONITOR_HUB_BIND=0.0.0.0
# 在反向代理（nginx、Traefik、Cloudflare Tunnel）後面時設 1，才會採用 X-Forwarded-*。
AI_SECURITY_MONITOR_HUB_TRUST_PROXY=
# 免金鑰加入：0＝關閉（電腦只能用註冊金鑰加入）。預設開。見 docs/enrollment.md
AI_SECURITY_MONITOR_HUB_ENROLL_REQUESTS=
# 加入模式：auto＝申請一送出就自動加入、review＝要管理員核准。留空＝在網頁「新增主機」設定（預設 auto）；有設就鎖定。
AI_SECURITY_MONITOR_HUB_ENROLL_MODE=
# 情資的使用情境：noncommercial＝也鏡像只限非商業用途的來源（DShield、URLhaus…，預設）、commercial＝只鏡像可以商用的來源（公司部署請設這個）。
# 留空＝在網頁「威脅情資 → 情資來源授權」設定；有設就鎖定。
AI_SECURITY_MONITOR_HUB_INTEL_USAGE=
# 區網 mDNS 廣播（讓電腦自動找到 Hub）：伺服器版預設開。Docker Desktop／bridge 網路廣播出不了區網，
# 請改用 network_mode: host（Linux）或在區網任一台執行 ai-security-monitor hub advertise --url <對外網址>
AI_SECURITY_MONITOR_HUB_MDNS=
# 電腦端看到的 Hub 名稱（預設 Security Hub）
AI_SECURITY_MONITOR_HUB_NAME=
# 1＝不登入也能看總覽（只有彙總資料）。
AI_SECURITY_MONITOR_HUB_PUBLIC_DASHBOARD=
# 映像版本（預設 latest）。
AI_SECURITY_MONITOR_HUB_IMAGE_TAG=latest

# 選填：遠端動作的簽章金鑰（不設會自動產生並存在資料庫）。
AI_SECURITY_MONITOR_HUB_ACTION_SIGNING_KEY=
# 選填：Hub MCP 專用 token（也可以在網頁建立有 MCP 權限的 API token）。
AI_SECURITY_MONITOR_HUB_MCP_TOKEN=
# 0＝不要每 6 小時查 GitHub 有沒有新版。
AI_SECURITY_MONITOR_HUB_UPDATE_CHECK=

# 選填：IP 分析頁「外部威脅情資」的金鑰（也可以在網頁「設定與金鑰 → 外部情資來源」貼上）。
# 只有管理員按「查詢外部情資」才會把 IP 送出去；AI_SECURITY_MONITOR_HUB_IP_LOOKUPS=off 整個關掉。
AI_SECURITY_MONITOR_HUB_ABUSEIPDB_KEY=
AI_SECURITY_MONITOR_HUB_IPINFO_TOKEN=
AI_SECURITY_MONITOR_HUB_PROXYCHECK_KEY=
AI_SECURITY_MONITOR_HUB_GREYNOISE_KEY=
# 選填：IP 分析頁「這個 IP 上的網域」的被動 DNS 反查（按「查詢網域」才送出；HackerTarget 不需要金鑰）。
AI_SECURITY_MONITOR_HUB_VIRUSTOTAL_KEY=
AI_SECURITY_MONITOR_HUB_OTX_KEY=
AI_SECURITY_MONITOR_HUB_HACKERTARGET_KEY=
AI_SECURITY_MONITOR_HUB_IP_LOOKUPS=

# 選填但建議：通知頻道祕密（SMTP 密碼、webhook 網址）的加密金鑰，32 bytes（openssl rand -hex 32）。設了之後不要改。
AI_SECURITY_MONITOR_HUB_SECRETS_KEY=

# 選填：網路流量／效能資料保留天數（每分鐘的原始樣本預設 7 天、每小時彙總預設 90 天）。
AI_SECURITY_MONITOR_HUB_METRICS_RAW_DAYS=
AI_SECURITY_MONITOR_HUB_METRICS_HOURLY_DAYS=
# 選填：DNS 查詢紀錄保留天數（每分鐘的原始紀錄預設 7 天、每小時彙總預設 90 天）。DNS 紀錄等於上網紀錄，依公司規定調整。
AI_SECURITY_MONITOR_HUB_DNS_RAW_DAYS=
AI_SECURITY_MONITOR_HUB_DNS_HOURLY_DAYS=
# 選填：防護 DNS（用含防護 DNS 的 docker/compose.dns.yml 或 compose.standalone.dns.yml 啟動時才用到；權杖必填）。權杖至少 32 字元、Hub 與 dns 共用，例 openssl rand -hex 24。
# DNS_BIND 是 dns 服務發布到哪個位址（預設 127.0.0.1；給區網用改成這台的區網 IP），DNS_PORT 預設 53。
AI_SECURITY_MONITOR_HUB_DNS_TOKEN=
AI_SECURITY_MONITOR_HUB_DNS_BIND=
AI_SECURITY_MONITOR_HUB_DNS_PORT=
# AI 分析紀錄保留天數（預設 90）、外部情資查詢快取保留天數（預設 30）；0＝不自動清。也可以在「設定與金鑰 → 資料清除」手動清。
AI_SECURITY_MONITOR_HUB_AI_RETENTION_DAYS=
AI_SECURITY_MONITOR_HUB_IPINTEL_CACHE_DAYS=

# 選填：Hub 上的 AI 分析（/ai）用的 Claude Code／Codex 憑證；也可以進容器登入（資料存在 /data）。
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
CODEX_API_KEY=
