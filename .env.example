# Security Hub（docker/compose.yml、docker/compose.standalone.yml）的設定。
# 複製成 .env 後填值：cp .env.example .env
# 產生隨機值：openssl rand -hex 32（Windows PowerShell：-join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })）

# 必填：管理員金鑰（登入網頁、管理 API）。
ASA_HUB_ADMIN_SECRET=
# 必填：PostgreSQL 密碼（只在 docker network 內使用）。
ASA_HUB_DB_PASSWORD=

# 選填：agent 上傳用的固定金鑰（逗號分隔）。也可以在網頁「管理 → 註冊金鑰」建立，建議用後者。
ASA_HUB_CLIENT_SECRETS=
# 對外網址（安裝指令、/install.sh 會用）。例：https://hub.example.com
ASA_HUB_PUBLIC_URL=
# 主機上的 port（預設 8088）與綁定位址（伺服器版預設 0.0.0.0；單機版固定 127.0.0.1）。
ASA_HUB_HOST_PORT=8088
ASA_HUB_BIND=0.0.0.0
# 在反向代理（nginx、Traefik、Cloudflare Tunnel）後面時設 1，才會採用 X-Forwarded-*。
ASA_HUB_TRUST_PROXY=
# 1＝不登入也能看總覽（只有彙總資料）。
ASA_HUB_PUBLIC_DASHBOARD=
# 映像版本（預設 latest）。
ASA_HUB_IMAGE_TAG=latest

# 選填：遠端動作的簽章金鑰（不設會自動產生並存在資料庫）。
ASA_HUB_ACTION_SIGNING_KEY=
# 選填：Hub MCP 專用 token（也可以在網頁建立有 MCP 權限的 API token）。
ASA_HUB_MCP_TOKEN=
# 0＝不要每 6 小時查 GitHub 有沒有新版。
ASA_HUB_UPDATE_CHECK=

# 選填：IP 分析頁「外部威脅情資」的金鑰（也可以在網頁「設定與金鑰 → 外部情資來源」貼上）。
# 只有管理員按「查詢外部情資」才會把 IP 送出去；ASA_HUB_IP_LOOKUPS=off 整個關掉。
ASA_HUB_ABUSEIPDB_KEY=
ASA_HUB_IPINFO_TOKEN=
ASA_HUB_PROXYCHECK_KEY=
ASA_HUB_GREYNOISE_KEY=
ASA_HUB_IP_LOOKUPS=

# 選填：Hub 上的 AI 分析（/ai）用的 Claude Code／Codex 憑證；也可以進容器登入（資料存在 /data）。
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
CODEX_API_KEY=
