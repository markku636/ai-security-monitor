# Security Hub 環境變數（開發時複製成 .env.local）。每個 *_SECRET / *_KEY 都可改用 <名稱>_FILE 指向 Docker secret 檔。
# 變數名改用 AI_SECURITY_MONITOR_HUB_*；舊的 ASA_HUB_* 照樣有效，兩個都設時新名優先。

# PostgreSQL 連線（必填）。開發：npm run dev:db 起本機容器。
AI_SECURITY_MONITOR_HUB_DATABASE_URL=postgres://asa_hub:asa_dev_only@127.0.0.1:55432/asa_hub

# 管理員金鑰。留空＝開放模式：只綁 127.0.0.1、所有人皆為管理員（單機版自用）。
# 產生：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AI_SECURITY_MONITOR_HUB_ADMIN_SECRET=

# agent 上傳用的 client 金鑰（逗號分隔，可多把；不可與管理員金鑰相同）。
AI_SECURITY_MONITOR_HUB_CLIENT_SECRETS=

# Keycloak OIDC 登入。Valid redirect URI：<AI_SECURITY_MONITOR_HUB_PUBLIC_URL>/api/auth/keycloak/callback
# Issuer、Client ID、允許信箱三個值都設好後，登入頁才會顯示 Keycloak 按鈕。
# Public client + PKCE 可留空 Client secret；若 Keycloak client 啟用 Client authentication 才需要填。
AI_SECURITY_MONITOR_HUB_KEYCLOAK_ISSUER=
AI_SECURITY_MONITOR_HUB_KEYCLOAK_CLIENT_ID=
AI_SECURITY_MONITOR_HUB_KEYCLOAK_CLIENT_SECRET=
AI_SECURITY_MONITOR_HUB_KEYCLOAK_ALLOWED_EMAILS=a4756830@gmail.com
AI_SECURITY_MONITOR_HUB_KEYCLOAK_IDP_HINT=google
AI_SECURITY_MONITOR_HUB_KEYCLOAK_ONLY=1

# 1＝不登入也能看儀表板（唯讀、隱藏 IP 等細節）。
AI_SECURITY_MONITOR_HUB_PUBLIC_DASHBOARD=

# server / standalone（只影響顯示與預設值）。
AI_SECURITY_MONITOR_HUB_EDITION=standalone

# 遠端動作（封鎖 IP 等）的簽署金鑰。沒設會自動產生並存進資料庫；設了資料庫外洩也偽造不了動作。
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SECURITY_MONITOR_HUB_ACTION_SIGNING_KEY=

# 情資登錄 feeds/ 目錄（預設找 ../feeds 或 ./feeds）
AI_SECURITY_MONITOR_HUB_FEEDS_DIR=

# Hub MCP（/api/mcp）專用 Bearer token；不設就只能用管理員金鑰。
AI_SECURITY_MONITOR_HUB_MCP_TOKEN=

# AI 分析頁：CLI 路徑（不在 PATH 時）、hub 自己的內部網址（CLI 連回 /api/mcp 用）、同時執行上限。
AI_SECURITY_MONITOR_HUB_CLAUDE_BIN=
AI_SECURITY_MONITOR_HUB_CODEX_BIN=
AI_SECURITY_MONITOR_HUB_INTERNAL_URL=
AI_SECURITY_MONITOR_HUB_AI_MAX_CONCURRENT=2
